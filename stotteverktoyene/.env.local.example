# Eksempel/template for stotteverktoyene/.env.local
# Kopier denne filen til .env.local (uten .example) og fyll inn verdier.
# .env.local er gitignored — verdiene forblir lokale.
#
# Brukes av Claude-skillen `.claude/skills/dev-preview-login/` for auto-login
# i dev-preview. Test-konto kun — ikke legg ekte/personlige credentials her.

DEV_LOGIN_EMAIL=testuser2@farmasiet.no
DEV_LOGIN_PASSWORD=

# Claude API (prototype: AI-generert kundetekst i Interaksjonssøk).
# NB: nøkkelen bundles til klienten i dev (dangerouslyAllowBrowser) – kun for
# lokal testing. Ikke deploy med nøkkelen i klienten; bruk en proxy i produksjon.
VITE_ANTHROPIC_API_KEY=
# Valgfritt – overstyr modell (standard: claude-opus-4-8).
# Billigere/raskere alternativer: claude-sonnet-4-6, claude-haiku-4-5
VITE_ANTHROPIC_MODEL=
